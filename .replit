entrypoint = "README.md"
modules = ["nodejs-22", "javascript", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["dig", "q", "glib", "nss", "nspr", "atk", "cups", "dbus", "libdrm", "libxkbcommon", "at-spi2-atk", "at-spi2-core", "cairo", "pango", "alsa-lib", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "expat"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run expo:web:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5199
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[env]
PORT = "5000"

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

# The push hook lives in this workspace's own dev server, so it can only be
# reached while the workspace is already awake. Syncing here is what a Repl
# that slept through a push has instead — and it must finish before anything
# below it serves the code it is replacing.
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:workflow:backend"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:workflow:frontend"
waitForPort = 8081
ensurePreviewReachable = "/status"

[userenv]

[userenv.development]
NODE_ENV = "development"

[userenv.production]
NODE_ENV = "production"
