{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hint-test-traps.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/loop/STATE.md\" ] && grep -q \"^status: RUNNING\" \"$CLAUDE_PROJECT_DIR/.claude/loop/STATE.md\" && cat \"$CLAUDE_PROJECT_DIR/.claude/loop/STATE.md\" \"$CLAUDE_PROJECT_DIR/.claude/loop/LESSONS.md\" || true"
          }
        ]
      }
    ]
  }
}
