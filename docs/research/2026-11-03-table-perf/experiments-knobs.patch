+// LOCAL-ONLY perf experiment knobs (not for commit): localStorage `__x_<name>` = "1".
+const read = (k: string): boolean => {
+  try {
+    return (globalThis as { localStorage?: Storage }).localStorage?.getItem(`__x_${k}`) === "1";
+  } catch {
+    return false;
+  }
+};
+export const knob = {
+  noParticles: read("noParticles"),
+  particleDpr1: read("particleDpr1"),
+  particleIdleSleep: read("particleIdleSleep"),
+  fallbackDpr1: read("fallbackDpr1"),
+  noFallbackBake: read("noFallbackBake"),
+  noSway: read("noSway"),
+  skiaDpr1: read("skiaDpr1"),
+  noGloss: read("noGloss"),
+  noHandShade: read("noHandShade"),
+  fixParticles: read("fixParticles"),
+  fixBake: read("fixBake"),
+  glossStep: read("glossStep"),
