+// LOCAL-ONLY perf lab (not for commit): steady-state cost of a live table, sampled while the
+// table waits on the viewer's own turn (nothing but ambient motion runs), and around each play.
+// Variants are localStorage knobs (`__x_*`) read by the local experiment patch.
+import { test, type CDPSession, type Page } from "@playwright/test";
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { resolve } from "node:path";
+import { openApp, startOfflineGame } from "./helpers/navigation";
+import { playAnyLegal } from "./helpers/bot";
+import { CANVASKIT_URL } from "../../lib/canvaskit";
+import { TABLE, TABLE_STATE } from "./helpers/selectors";
+import { YOUR_TURN_PREFIX } from "./helpers/labels";
+
+const OUT = "/tmp/claude-0/-home-user-murlan/9eb84156-ef46-5ca3-9201-81e4e5173f28/scratchpad/perf/lab";
+const INIT = "/tmp/claude-0/-home-user-murlan/9eb84156-ef46-5ca3-9201-81e4e5173f28/scratchpad/perf/probe/init.js";
+const env = process.env;
+const LABEL = env.PROBE_LABEL ?? "lab";
+const RATE = Number(env.PROBE_RATE ?? 1);
+const DPR = Number(env.PROBE_DPR ?? 3);
+const SAMPLES = Number(env.PROBE_SAMPLES ?? 4);
+const WIN = Number(env.PROBE_WIN ?? 4000);
+const SKIA = env.PROBE_SKIA === "1";
+const KNOBS = (env.PROBE_KNOBS ?? "").split(",").filter(Boolean);
+const PROFILE = env.PROBE_PROFILE === "1";
+const CK_DIR = resolve(__dirname, "../../node_modules/canvaskit-wasm/bin/full/");
+
+async function prepare(page: Page) {
+  await page.route(`${CANVASKIT_URL}**`, (route) => {
+    const file = route.request().url().split("/").pop()!;
+    route.fulfill({
+      body: readFileSync(resolve(CK_DIR, file)),
+      contentType: file.endsWith(".wasm") ? "application/wasm" : "application/javascript",
+      headers: { "access-control-allow-origin": "*" },
+    });
+  });
+  await page.addInitScript((knobs: string[]) => {
+    for (const k of knobs) localStorage.setItem(`__x_${k}`, "1");
+  }, KNOBS);
+  if (SKIA) {
+    await page.addInitScript(() => {
+      const fake = "ANGLE (Apple, ANGLE Metal Renderer: Apple M2, Unspecified Version)";
+      for (const C of [WebGLRenderingContext, WebGL2RenderingContext]) {
+        const get = C.prototype.getParameter;
+        C.prototype.getParameter = function (p: number) {
+          if (p === 0x9246 || p === 0x1f01) return fake;
+          return get.call(this, p);
+        };
+      }
+      const gc = HTMLCanvasElement.prototype.getContext;
+      HTMLCanvasElement.prototype.getContext = function (this: HTMLCanvasElement, kind: string, attrs?: Record<string, unknown>) {
+        if (attrs && attrs.failIfMajorPerformanceCaveat) attrs = { ...attrs, failIfMajorPerformanceCaveat: false };
+        return gc.call(this, kind, attrs);
+      } as typeof gc;
+    });
+  }
+  await page.addInitScript({ path: INIT });
+  await page.emulateMedia({ reducedMotion: env.PROBE_REDUCED === "1" ? "reduce" : "no-preference" });
+}
+
+async function busyWindow(cdp: CDPSession, page: Page, ms: number) {
+  // Main-thread busy from CDP Performance metrics (TaskDuration etc.), frames from the in-page recorder.
+  const m0 = Object.fromEntries((await cdp.send("Performance.getMetrics")).metrics.map((m) => [m.name, m.value]));
+  const t0 = await page.evaluate(() => performance.now());
+  await page.waitForTimeout(ms);
+  const t1 = await page.evaluate(() => performance.now());
+  const m1 = Object.fromEntries((await cdp.send("Performance.getMetrics")).metrics.map((m) => [m.name, m.value]));
+  const d = (k: string) => +(((m1[k] - m0[k]) * 1000) / ((t1 - t0) / 1000)).toFixed(1);
+  const frames = await page.evaluate(([a, b]) => {
+    const f = (window as unknown as { __perf: { frames: number[]; longtasks: number[][] } }).__perf;
+    const fs = f.frames.filter((t) => t >= a && t <= b);
+    const iv = fs.slice(1).map((t, i) => t - fs[i]);
+    const s = [...iv].sort((x, y) => x - y);
+    const q = (p: number) => s[Math.min(s.length - 1, Math.floor(s.length * p))] ?? 0;
+    return {
+      fps: +(fs.length / ((b - a) / 1000)).toFixed(1),
+      p50: +q(0.5).toFixed(1),
+      p95: +q(0.95).toFixed(1),
+      worst: +(s[s.length - 1] ?? 0).toFixed(1),
+      janky: iv.filter((x) => x > 33.4).length,
+      longTasks: f.longtasks.filter(([t]) => t >= a && t <= b).length,
+    };
+  }, [t0, t1]);
+  // ms of main-thread work per second of wall time, by kind.
+  return {
+    ...frames,
+    taskMsPerSec: d("TaskDuration"),
+    scriptMsPerSec: d("ScriptDuration"),
+    layoutMsPerSec: d("LayoutDuration"),
+    styleMsPerSec: d("RecalcStyleDuration"),
+    t0,
+    t1,
+  };
+}
+
+const myTurn = (page: Page, timeout: number) =>
+  page.locator(`${TABLE}[${TABLE_STATE}^="${YOUR_TURN_PREFIX}"]`).waitFor({ timeout }).then(() => true, () => false);
+
+test("perf lab", async ({ browser, baseURL }) => {
+  test.setTimeout(15 * 60_000);
+  mkdirSync(OUT, { recursive: true });
+  const ctx = await browser.newContext({ locale: "it-IT", viewport: { width: 874, height: 402 }, deviceScaleFactor: DPR });
+  const page = await ctx.newPage();
+  await prepare(page);
+  const cdp = await ctx.newCDPSession(page);
+  await cdp.send("Performance.enable", { timeDomain: "threadTicks" });
+  await openApp(page, baseURL!);
+  if (RATE > 1) await cdp.send("Emulation.setCPUThrottlingRate", { rate: RATE });
+  await startOfflineGame(page, { playerCount: 4, gameMode: "free_for_all" });
+  // Let the deal and (with Skia) CanvasKit settle.
+  await page.waitForTimeout(5000);
+  const turnWindows = [];
+  const playWindows = [];
+  if (PROFILE || env.PROBE_PROFILE_PLAY === "1") {
+    await cdp.send("Profiler.enable");
+    await cdp.send("Profiler.setSamplingInterval", { interval: 200 });
+  }
+  for (let i = 0; i < SAMPLES; i++) {
+    if (!(await myTurn(page, 120_000))) break;
+    await page.waitForTimeout(600);
+    if (PROFILE && i === 0) await cdp.send("Profiler.start");
+    turnWindows.push(await busyWindow(cdp, page, WIN));
+    if (PROFILE && i === 0) {
+      const { profile } = await cdp.send("Profiler.stop");
+      writeFileSync(`${OUT}/${LABEL}.turn.cpuprofile`, JSON.stringify(profile));
+    }
+    // Play, then measure the 2.5 s that follow (throw, landing, bots' replies).
+    if (env.PROBE_PROFILE_PLAY === "1") await cdp.send("Profiler.start");
+    const played = playAnyLegal(page);
+    const after = busyWindow(cdp, page, 2500);
+    await played;
+    playWindows.push(await after);
+    if (env.PROBE_PROFILE_PLAY === "1") {
+      const { profile } = await cdp.send("Profiler.stop");
+      writeFileSync(`${OUT}/${LABEL}.play${i}.cpuprofile`, JSON.stringify(profile));
+    }
+  }
+  const agg = (ws: Record<string, number>[]) => {
+    const keys = Object.keys(ws[0] ?? {}).filter((k) => k !== "t0" && k !== "t1");
+    return Object.fromEntries(keys.map((k) => [k, +(ws.reduce((a, w) => a + w[k], 0) / ws.length).toFixed(1)]));
+  };
+  const canv = await page.evaluate(() => [...document.querySelectorAll("canvas")].map((c) => `${c.width}x${c.height}`));
+  const layers = await page.evaluate(() => {
+    const n = (id: string) => document.querySelectorAll(`[data-testid="${id}"]`).length;
+    return {
+      glossSpot: n("card-gloss-spot"),
+      glossStreak: n("card-gloss-streak"),
+      foilInk: n("card-foil-ink"),
+      foilBand: n("card-foil-band"),
+      levelShade: n("card-level-shade"),
+      cardBoxes: n("card-box"),
+      dom: document.querySelectorAll("*").length,
+      willChange: [...document.querySelectorAll("*")].filter((e) => getComputedStyle(e).willChange !== "auto").length,
+    };
+  });
+  console.log(`[lab] ${LABEL} layers ${JSON.stringify(layers)}`);
+  const res = { label: LABEL, rate: RATE, dpr: DPR, skia: SKIA, knobs: KNOBS, canvases: canv, turn: agg(turnWindows), play: agg(playWindows), turnWindows, playWindows };
+  writeFileSync(`${OUT}/${LABEL}.json`, JSON.stringify(res));
+  console.log(`[lab] ${LABEL} turn ${JSON.stringify(res.turn)}`);
+  console.log(`[lab] ${LABEL} play ${JSON.stringify(res.play)}`);
+  console.log(`[lab] ${LABEL} canvases ${canv.join(" ")}`);
+  await ctx.close();
+});
