+
+const CK_DIR = resolve(__dirname, "../../node_modules/canvaskit-wasm/bin/full/");
+
+async function readStream(cdp: CDPSession, handle: string): Promise<string> {
+  let out = "";
+  for (;;) {
+    const r = await cdp.send("IO.read", { handle, size: 1 << 20 });
+    out += r.base64Encoded ? Buffer.from(r.data, "base64").toString() : r.data;
+    if (r.eof) break;
+  }
+  await cdp.send("IO.close", { handle });
+  return out;
+}
+
+async function prepare(page: Page) {
+  await page.route(`${CANVASKIT_URL}**`, (route) => {
+    const file = route.request().url().split("/").pop()!;
+    route.fulfill({
+      body: readFileSync(resolve(CK_DIR, file)),
+      contentType: file.endsWith(".wasm") ? "application/wasm" : "application/javascript",
+      headers: { "access-control-allow-origin": "*" },
+    });
+  });
+  if (REACT) await page.addInitScript(() => localStorage.setItem("__perfReact", "1"));
+  const knobs = (env.PROBE_KNOBS ?? "").split(",").filter(Boolean);
+  await page.addInitScript((ks: string[]) => {
+    for (const k of ks) localStorage.setItem(`__x_${k}`, "1");
+  }, knobs);
+  if (SKIA) {
+    await page.addInitScript(() => {
+      const fake = "ANGLE (Apple, ANGLE Metal Renderer: Apple M2, Unspecified Version)";
+      for (const C of [WebGLRenderingContext, WebGL2RenderingContext]) {
+        const get = C.prototype.getParameter;
+        C.prototype.getParameter = function (p: number) {
+          if (p === 0x9246 || p === 0x1f01) return fake;
+          return get.call(this, p);
+        };
+      }
+      const gc = HTMLCanvasElement.prototype.getContext;
+      HTMLCanvasElement.prototype.getContext = function (this: HTMLCanvasElement, kind: string, attrs?: Record<string, unknown>) {
+        if (attrs && attrs.failIfMajorPerformanceCaveat) attrs = { ...attrs, failIfMajorPerformanceCaveat: false };
+        return gc.call(this, kind, attrs);
+      } as typeof gc;
+    });
+  }
+  await page.addInitScript({ path: INIT });
+  await page.emulateMedia({ reducedMotion: "no-preference" });
+}
+
+test("perf probe", async ({ browser, baseURL }) => {
+  mkdirSync(OUT, { recursive: true });
+  const ctx = await browser.newContext({
+    locale: "it-IT",
+    viewport: { width: 874, height: 402 },
+    deviceScaleFactor: DPR,
+  });
+  const page = await ctx.newPage();
+  const errors: string[] = [];
+  page.on("pageerror", (e) => errors.push(e.message));
+  await prepare(page);
+  const cdp = await ctx.newCDPSession(page);
+
+  await openApp(page, baseURL!);
+  if (MODE === "online") {
+    await registerNewAccount(page, uniqueUsername("perf"));
+    await goToOnlineLobby(page);
+    await createRoom(page, { playerCount: PLAYERS, gameMode: "free_for_all" });
+  }
+
+  if (RATE > 1) await cdp.send("Emulation.setCPUThrottlingRate", { rate: RATE });
+  if (PROFILE) {
+    await cdp.send("Profiler.enable");
+    await cdp.send("Profiler.setSamplingInterval", { interval: 250 });
+    await cdp.send("Profiler.start");
+  }
+  let traceDone: Promise<string> | null = null;
+  if (TRACE_MS > 0) {
+    traceDone = new Promise((res) => cdp.once("Tracing.tracingComplete", (e) => res(readStream(cdp, e.stream!))));
+    await cdp.send("Tracing.start", {
+      transferMode: "ReturnAsStream",
+      traceConfig: {
+        includedCategories: [
+          "devtools.timeline",
+          "disabled-by-default-devtools.timeline",
+          "disabled-by-default-devtools.timeline.frame",
+          "v8",
+          "v8.execute",
+          "blink.user_timing",
+          "loading",
+          "latencyInfo",
+          "gpu",
+          "cc",
+          "viz",
+        ],
+      },
+    });
+  }
+
+  const startedAt = await page.evaluate(() => performance.now());
+  if (MODE === "online") await fillWithBotsAndStart(page);
+  else await startOfflineGame(page, { playerCount: PLAYERS, gameMode: "free_for_all" });
+
+  const stopTrace = TRACE_MS > 0 ? setTimeout(() => cdp.send("Tracing.end").catch(() => {}), TRACE_MS) : null;
+  const moves: string[] = [];
+  const roundEnds: number[] = [];
+  let driveError: string | null = null;
+  for (let r = 0; r < ROUNDS && !driveError; r++) {
+    await driveGameToCompletion(page, {
+      isFinished: untilNextDeal(),
+      maxTotalMs: 12 * 60_000,
+      stallMs: 60_000,
+      log: (l) => moves.push(l),
+    }).catch((e) => (driveError = String(e)));
+    roundEnds.push(await page.evaluate(() => performance.now()));
+  }
+  // A settled table as the control.
+  await page.waitForTimeout(4_000);
+  const idleFrom = await page.evaluate(() => performance.now());
+  await page.waitForTimeout(4_000);
+  const endedAt = await page.evaluate(() => performance.now());
+
+  if (stopTrace) clearTimeout(stopTrace);
+  if (traceDone) {
+    await cdp.send("Tracing.end").catch(() => {});
+    writeFileSync(`${OUT}/${LABEL}.trace.json`, await traceDone);
+  }
+  if (PROFILE) {
+    const { profile } = await cdp.send("Profiler.stop");
+    writeFileSync(`${OUT}/${LABEL}.cpuprofile`, JSON.stringify(profile));
+  }
+  const data = await page.evaluate(() => {
+    const P = (window as unknown as { __perf: Record<string, unknown> }).__perf;
+    const canv = [...document.querySelectorAll("canvas")].map((c) => ({
+      w: c.width,
+      h: c.height,
+      cw: c.clientWidth,
+      ch: c.clientHeight,
+    }));
+    const all = document.querySelectorAll("*");
+    let transformed = 0;
+    let animatedStyles = 0;
+    for (const el of all) {
+      const cs = getComputedStyle(el);
+      if (cs.transform && cs.transform !== "none") transformed++;
+      if ((el as HTMLElement).style && (el as HTMLElement).style.cssText.includes("transform")) animatedStyles++;
+    }
+    return {
+      ...P,
+      canvases: canv,
+      domNodes: all.length,
+      transformed,
+      inlineTransform: animatedStyles,
+      svgNodes: document.querySelectorAll("svg *").length,
+      imgs: document.querySelectorAll("img").length,
+    };
+  });
+  writeFileSync(
+    `${OUT}/${LABEL}.json`,
+    JSON.stringify({ label: LABEL, rate: RATE, mode: MODE, dpr: DPR, skia: SKIA, startedAt, roundEnds, idleFrom, endedAt, moves, errors, driveError, ...data })
+  );
+  await ctx.close();
+});
