{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "What this process did with its ticket, as queue.md says to declare it: the same fields, the same values. handoff is null and stoodDown false where that declaration names none.",
  "type": "object",
  "required": ["ticket", "handoff", "stoodDown"],
  "properties": {
    "ticket": { "type": "integer" },
    "branch": { "type": "string" },
    "pr": { "type": "integer" },
    "phase": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
    "handoff": { "enum": ["A", "B", "C", "D", "E", "F", null] },
    "stoodDown": { "type": "boolean" },
    "why": { "type": "string", "maxLength": 1500 }
  }
}
