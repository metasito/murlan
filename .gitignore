# local dev stack
.dev-stack/

# Playwright E2E output
tests/e2e/test-results/
tests/e2e/playwright-report/
test-results/
playwright-report/

# graphify build output. The curated graph (graph.json, graph.html,
# GRAPH_REPORT.md, manifest.json, .graphify_labels.json) is tracked; these are
# not. The AST cache is regenerable, and graphify snapshots the curated graph
# into a dated folder on every rebuild — 3 MB a day, backing up a file git
# already has every version of.
graphify-out/cache/
graphify-out/20*/
graphify-out/_run_*.py
graphify-out/_chunks.json
graphify-out/.graphify_uncached.txt
