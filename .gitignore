# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Agent worktrees. Nested so Node's ancestor lookup finds the install above them;
# named here, in tsconfig.json and in eslint.config.js so no tool walks a second
# copy of the tree. `/loop` phase A creates them.
.worktrees/
.claude/worktrees/

# Expo
.expo/
dist/
static-build/
web-build/
expo-env.d.ts

# Server build output
server_dist/

# Web source maps — moved out of dist/ by scripts/moveSourceMaps.mjs, read
# only by server/sourceMaps.ts, never served
sourcemaps/

# Coverage
coverage/

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# EAS / store credentials
google-service-account.json
*.keystore

# typescript
*.tsbuildinfo
.vercel

.env

# tool scratch / runtime noise
.superpowers/
*.log
test-output.txt

# local dev stack
.dev-stack/

# Playwright E2E output
tests/e2e/test-results/
tests/e2e/playwright-report/
test-results/
playwright-report/

# graphify build output — regenerable from source by `graphify update .`
graphify-out/

# Database dumps — real account data, never committed
backups/
*.sql

# Superdesign scratch
.superdesign/

# Agent scratch: throwaway harnesses that need repo-relative imports.
# tests/e2e/ is the suite's contract — scratch specs go here instead.
.scratch/

