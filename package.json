{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "expo:dev:clean": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost --clear",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "expo:web:build": "node scripts/assertNotE2EFast.js && npx expo export --platform web --source-maps && node scripts/moveSourceMaps.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "server:build": "esbuild server/index.ts --platform=node --target=node22 --packages=external --bundle --format=esm --outdir=server_dist --out-extension:.js=.mjs",
    "server:prod": "NODE_ENV=production node server_dist/index.mjs",
    "db:push": "drizzle-kit push",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:prune": "node scripts/prune-backups.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "db:reset": "node scripts/reset-db.mjs && drizzle-kit push",
    "start": "npx expo start",
    "lint": "npx expo lint . -- --max-warnings 0",
    "lint:fix": "npx expo lint . --fix",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:native": "jest",
    "perf:web": "playwright test --config tests/e2e/playwright.perf.config.ts --reporter=line",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "node scripts/checkStrictIndexed.mjs",
    "verify": "npm run typecheck && npm run typecheck:strict && npm run test && npm run test:native && npm run lint",
    "ticket": "tsx scripts/ticket-pipeline.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.83.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.12",
    "expo-system-ui": "~6.0.9",
    "express": "^5.0.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "source-map": "^0.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@breezystack/lamejs": "^1.2.7",
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/react": "~19.1.10",
    "drizzle-kit": "^0.31.4",
    "esbuild": "0.27.2",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "mpg123-decoder": "^1.0.3",
    "patch-package": "^8.0.0",
    "subset-font": "^2.5.0",
    "test-renderer": "^1.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
