{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "npx expo start --tunnel",
    "expo:dev:clean": "npx expo start --tunnel --clear",
    "server:dev": "node --watch server/index.ts",
    "expo:web:build": "node scripts/assertNotE2EFast.js && npx expo export --platform web --source-maps && node scripts/moveSourceMaps.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "server:build": "esbuild server/index.ts --platform=node --target=node26 --packages=external --bundle --format=esm --outdir=server_dist --out-extension:.js=.mjs",
    "server:prod": "node scripts/server-prod.mjs",
    "db:push": "drizzle-kit push",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:prune": "node scripts/prune-backups.mjs",
    "agent:check": "node tools/loop/agent-check.mjs",
    "worktrees:prune": "node tools/loop/workspace.mjs sweep",
    "worktrees:remove": "node tools/loop/workspace.mjs remove",
    "reap": "node tools/loop/reap.mjs",
    "queue:claim": "node tools/loop/claim.mjs",
    "queue:loop": "node tools/loop/run-loop.mjs",
    "queue:pre": "node tools/loop/workspace.mjs check",
    "start": "npx expo start",
    "play": "node scripts/e2e-server.mjs --play",
    "ios:device": "node scripts/ios-device.mjs",
    "lint": "npx expo lint . -- --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "npx expo lint . --fix",
    "pretest": "node tools/ci/preflightMemory.mjs",
    "preloop:test": "node tools/ci/preflightMemory.mjs",
    "loop:test": "node scripts/nodeTest.mjs --import ./tools/loop/tests/helpers/clearLoopEnv.mjs --test --test-timeout=120000 --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/helpers/timeoutHeadroomReporter.mjs --test-reporter-destination=stderr --test-reporter=./tests/helpers/filesRunReporter.mjs --test-reporter-destination=stderr \"tools/loop/tests/**/*.test.ts\"",
    "test": "node scripts/nodeTest.mjs --import ./tests/helpers/fileDeadline.mjs --test --test-concurrency=8 --test-timeout=120000 --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/helpers/timeoutHeadroomReporter.mjs --test-reporter-destination=stderr --test-reporter=./tests/helpers/filesRunReporter.mjs --test-reporter-destination=stderr \"tests/**/*.test.ts\"",
    "test:native": "jest",
    "test:native:related": "node tools/loop/related-tests.mjs",
    "perf:web": "playwright test --config tests/e2e/playwright.perf.config.ts --reporter=line",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "typecheck:strict": "node scripts/checkStrictIndexed.mjs",
    "bake:card-art": "node scripts/bake-card-art.mjs",
    "loop:cost": "node tools/loop/loop-cost.mjs",
    "verify": "npm run typecheck && npm run typecheck:strict && npm run test && npm run test:native && npm run lint",
    "soak": "node tests/soak/soak.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@prometheus-io/client": "^0.16.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@socket.io/component-emitter": "^3.1.2",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@tanstack/react-query": "^5.105.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-system-ui": "~58.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "rate-limit-redis": "^6.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-turbo-haptics": "1.2.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "redis": "6.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "source-map": "^0.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@breezystack/lamejs": "^1.2.7",
    "@expo/env": "^2.5.3",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.88.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "canvaskit-wasm": "^0.41.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "fontverter": "^2.0.0",
    "globals": "^17.14.0",
    "harfbuzzjs": "1.6.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "mpg123-decoder": "^1.0.3",
    "patch-package": "^8.0.0",
    "playwright": "^1.64.1",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2",
    "yaml": "^2.9.1"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "overrides": {
    "@expo/cli": {
      "zod": "$zod"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-expo": {
      "eslint": "$eslint"
    },
    "test-exclude": "^8.0.0",
    "jsdom": "^30.1.3",
    "qs": "^6.17.1",
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
