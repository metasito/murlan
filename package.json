{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "npx expo start --tunnel",
    "expo:dev:clean": "npx expo start --tunnel --clear",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:web:build": "node scripts/assertNotE2EFast.js && npx expo export --platform web --source-maps && node scripts/moveSourceMaps.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "server:build": "esbuild server/index.ts --platform=node --target=node22 --packages=external --bundle --format=esm --outdir=server_dist --out-extension:.js=.mjs",
    "server:prod": "NODE_ENV=production node server_dist/index.mjs",
    "db:push": "drizzle-kit push",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:prune": "node scripts/prune-backups.mjs",
    "agent:check": "node tools/loop/agent-check.mjs",
    "worktrees:prune": "node tools/loop/prune-worktrees.mjs",
    "worktrees:remove": "node tools/loop/prune-worktrees.mjs --remove",
    "reap": "node tools/loop/reap.mjs",
    "queue:claim": "node tools/loop/claim.mjs",
    "queue:loop": "node tools/loop/queue-loop.mjs",
    "queue:pre": "node tools/loop/queue-pre.mjs",
    "db:reset": "node scripts/reset-db.mjs && drizzle-kit push",
    "start": "npx expo start",
    "play": "node scripts/e2e-server.mjs --play",
    "lint": "npx expo lint . -- --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "npx expo lint . --fix",
    "pretest": "node tools/ci/preflightMemory.mjs",
    "preloop:test": "node tools/ci/preflightMemory.mjs",
    "loop:test": "node --test --test-timeout=30000 --test-force-exit \"tools/loop/tests/**/*.test.ts\"",
    "test": "node --test --test-timeout=30000 --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/helpers/filesRunReporter.mjs --test-reporter-destination=stderr \"tests/**/*.test.ts\"",
    "test:native": "jest",
    "perf:web": "playwright test --config tests/e2e/playwright.perf.config.ts --reporter=line",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "node scripts/checkStrictIndexed.mjs",
    "check:comments": "node tools/loop/comment-budget.mjs",
    "loop:cost": "node tools/loop/loop-cost.mjs",
    "verify": "npm run typecheck && npm run typecheck:strict && npm run test && npm run test:native && npm run lint",
    "soak": "node --experimental-strip-types tests/soak/soak.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@socket.io/postgres-adapter": "^0.5.0",
    "@tanstack/react-query": "^5.83.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "express": "^5.0.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "source-map": "^0.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/react": "~19.2.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "0.27.2",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "mpg123-decoder": "^1.0.3",
    "patch-package": "^8.0.0",
    "subset-font": "^2.5.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
